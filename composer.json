{
  "name": "kanti/letsencrypt-client",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "~8.4.0",
    "ext-curl": "*",
    "ext-yaml": "*",
    "symfony/config": "^7.4.22",
    "symfony/console": "^7.4.22",
    "symfony/dependency-injection": "^7.4.22",
    "symfony/error-handler": "^7.4.22",
    "symfony/finder": "^7.4.22",
    "symfony/lock": "^7.4.22",
    "symfony/process": "^7.4.22",
    "symfony/var-dumper": "^7.4.22",
    "symfony/yaml": "^7.4.22",
    "thecodingmachine/safe": "^3.4"
  },
  "require-dev": {
    "phpunit/phpunit": ">=12.4.3",
    "pluswerk/grumphp-config": "^10.2.7"
  },
  "autoload": {
    "psr-4": {
      "Kanti\\LetsencryptClient\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kanti\\LetsencryptClient\\Tests\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "pluswerk/grumphp-config": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.4.0"
    },
    "process-timeout": 0,
    "sort-packages": true
  },
  "scripts": {
    "post-update-cmd": [
      "composer bump"
    ],
    "test": "./vendor/bin/phpunit tests"
  }
}
